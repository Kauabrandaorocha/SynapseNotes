# ===== Aplicação =====
# Ambiente de execução (development | production | test)
NODE_ENV=development
# Porta do servidor HTTP back-end
PORT=3333
# Origens permitidas para requisições cross-origin (CORS)
CORS_ORIGIN=http://localhost:5173

# ===== Banco (PostgreSQL no docker-compose) =====
# Usuário de acesso ao banco PostgreSQL
POSTGRES_USER=notes
# Senha de acesso ao banco PostgreSQL
POSTGRES_PASSWORD=sua_senha_segura_aqui
# Nome da base de dados principal
POSTGRES_DB=notes_db
# Connection string JDBC/URI do PostgreSQL
DATABASE_URL=postgresql://notes:sua_senha_segura_aqui@localhost:5432/notes_db

# ===== JWT =====
# Chave secreta de assinatura do token de acesso (mínimo 64 caracteres hex)
JWT_ACCESS_SECRET=gere_um_segredo_aleatorio_de_64_chars
# Chave secreta de assinatura do token de renovação (distinta do access secret)
JWT_REFRESH_SECRET=gere_outro_segredo_diferente_de_64_chars
# Tempo de expiração do Access Token (ex: 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m
# Tempo de expiração do Refresh Token (ex: 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ===== AWS =====
# Região AWS dos recursos S3 e SQS
AWS_REGION=sa-east-1
# Credenciais de acesso AWS IAM
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Nome do bucket S3 para upload de mídias/áudios
S3_BUCKET_NAME=
# Tempo de expiração das URLs pré-assinadas em segundos
S3_PRESIGNED_URL_EXPIRES_IN=300
# URL da fila SQS para processamento assíncrono
SQS_QUEUE_URL=
# URL da fila Dead-Letter Queue (DLQ) para falhas
SQS_DLQ_URL=
# Endpoint customizado para LocalStack em dev (vazio em produção)
AWS_ENDPOINT_URL=http://localhost:4566

# ===== Limites de upload de áudio =====
# Tamanho máximo permitido para envio de áudio em megabytes
AUDIO_MAX_SIZE_MB=10
# Duração máxima permitida para gravação de áudio em segundos
AUDIO_MAX_DURATION_SECONDS=300

# ===== IA (Gemini) =====
# Chave de API Google Gemini (AI Studio)
GEMINI_API_KEY=
# Modelo Gemini a ser utilizado para síntese e transcrição
GEMINI_MODEL=gemini-2.0-flash
# Cota máxima diária de requisições de IA por usuário
LLM_DAILY_QUOTA_PER_USER=50

# ===== Worker =====
# Quantidade de tarefas processadas em paralelo pelo worker
WORKER_CONCURRENCY=2
# Número máximo de tentativas de reprocessamento em caso de erro
WORKER_MAX_RETRIES=3
